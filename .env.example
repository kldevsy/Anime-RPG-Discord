# ==========================================
# DISCORD CONFIGURATION
# ==========================================

# Bot Token - Obtido em: https://discord.com/developers/applications
# Vá em: Your App → Bot → Reset Token
DISCORD_TOKEN=

# Client ID - Obtido em: https://discord.com/developers/applications
# Vá em: Your App → OAuth2 → Client ID
DISCORD_CLIENT_ID=

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# PostgreSQL Connection String
# Formato: postgresql://usuario:senha@host:porta/database

# Exemplo Neon (https://neon.tech):
# DATABASE_URL=postgresql://usuario:senha@ep-xxx.us-east-2.aws.neon.tech/neondb

# Exemplo Supabase (https://supabase.com):
# DATABASE_URL=postgresql://postgres:senha@db.xxx.supabase.co:5432/postgres

# Exemplo Local:
# DATABASE_URL=postgresql://postgres:senha@localhost:5432/anime_rpg

DATABASE_URL=

# ==========================================
# ENVIRONMENT
# ==========================================

# Ambiente: development, production
NODE_ENV=production

# ==========================================
# INSTRUÇÕES
# ==========================================

# 1. Copie este arquivo para .env
# 2. Preencha os valores acima
# 3. NUNCA faça commit do .env (já está no .gitignore)
# 4. Na Discloud, configure as variáveis no painel web
