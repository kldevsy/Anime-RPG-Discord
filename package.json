{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:api-server": "pnpm --filter @workspace/api-server build",
    "bot:api-server": "pnpm --filter @workspace/api-server bot",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "start": "node start-bot.mjs",
    "start:quick": "cd artifacts/api-server && node --enable-source-maps ./dist/bot/index.mjs",
    "migrate": "node lib/db/scripts/apply-all-migrations.mjs",
    "seed": "cd lib/db && pnpm run seed"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
