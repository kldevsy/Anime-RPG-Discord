{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:api-server": "pnpm --filter @workspace/api-server build",
    "bot:api-server": "pnpm --filter @workspace/api-server bot",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "start": "node start-bot.mjs",
    "start:quick": "cd artifacts/api-server && node --enable-source-maps ./dist/bot/index.mjs",
    "migrate": "node lib/db/scripts/apply-all-migrations.mjs",
    "seed": "cd lib/db && pnpm run seed"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "discord.js": "^14.18.0",
    "express": "^5.2.1",
    "drizzle-orm": "^0.37.2",
    "postgres": "^3.4.7",
    "pg": "^8.13.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
